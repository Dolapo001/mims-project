# ==============================================================================
# AdWise Django Backend - Environment Variables Configuration
# ==============================================================================

# 1. Core Security & Django Settings
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=django-insecure-ezn77lv1t$b=+=t%r&+4^nz#5urufe7!!ajb=oki_$s^n=!*22
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# 2. CORS Origins Whitelist (Comma-separated)
# Leave blank to allow all origins in development. In production, restrict to your frontend domains.
CORS_ALLOWED_ORIGINS=http://localhost:7000,http://localhost:3000

# 3. Database Connection Configuration
# Leave blank to automatically use your local SQLite database (db.sqlite3).
# Set this to your persistent Postgres link (Neon/Supabase) in production.
# DATABASE_URL=postgres://user:password@host:port/database
